# ---------------------------------------------------------------------------
# TenderBridge API environment
# Copy to server/.env and fill in. server/.env is git-ignored — never commit it.
# This file is the ONLY place process.env is read (src/config/env.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Neon Postgres ---------------------------------------------------------
# DATABASE_URL = POOLED endpoint (hostname contains "-pooler"). Used by the app.
# DIRECT_URL   = DIRECT endpoint (no "-pooler"). Used by prisma migrate/db push/
#                db seed/studio. Prisma picks it up automatically via directUrl —
#                you never pass it by hand.
# sslmode=require is mandatory. pgbouncer=true on the pooled URL disables
# prepared statements and is required, not optional.
#
# FALLBACK: this app uses interactive prisma.$transaction() heavily (GRN confirm,
# payment settle, approval decide). If you ever see
#   prepared statement "s0" already exists
# or transaction-scope errors, point DATABASE_URL at the DIRECT endpoint with
# connection_limit=5. Safe here because there is exactly one API instance.
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=10"
DIRECT_URL="postgresql://USER:PASS@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Generate each one separately — THE TWO SECRETS MUST BE DIFFERENT:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- URLs ------------------------------------------------------------------
# APP_URL is the client origin: it is the exact CORS origin (never "*", or the
# refresh-token cookie silently stops working) and the base for email links.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Cloudinary (plan 14; optional until then) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (plan 14; optional — falls back to logging the mail) -------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TenderBridge <no-reply@tenderbridge.local>"

# Error reporting. Unset means off, which is the normal state locally and in
# test. Set it on Render only.
SENTRY_DSN=
