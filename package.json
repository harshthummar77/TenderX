{
  "name": "tenderbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant source-to-pay procurement platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build -w shared",
    "dev:shared": "npm run dev -w shared",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev": "npm run build:shared && concurrently -n shared,server,client -c gray,cyan,magenta \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build:shared && npm run build -w server && npm run build -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:studio": "npm run db:studio -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run build:shared && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "npm run test:unit -w server",
    "test:integration": "npm run test:integration -w server",
    "check:conventions": "npm run check:conventions -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5.6",
    "typescript-eslint": "^8"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
